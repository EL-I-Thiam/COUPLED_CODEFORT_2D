&sim_params
  case_type          = 'rising_bubble'
  Lx                 = 1.0d0
  Ly                 = 2.0d0
  Nx_global          = 32
  Ny_global          = 64
  rho1               = 1000.0d0
  rho2               = 100.0d0
  mu1                = 10.0d0
  mu2                = 1.0d0
  sigma              = 24.5d0
  gx                 = 0.0d0
  gy                 = -0.98d0
  dt                 = 2.0d-3
  t_final            = 0.10d0
  cfl_target         = 0.25d0
  max_time_steps     = 100
  time_order         = 2
  tol_bicgstab2      = 1.0d-5
  max_iter_bicgstab2 = 150
  alpha_penalty      = 1.0d12
  periodic_x         = .false.
  periodic_y         = .false.
  adaptive_dt        = .true.
  consistent_amp     = .true.
  use_bicgstab2      = .false.
  restart            = .false.
  vtk_freq           = 20
  chk_freq           = 50
  u_lid              = 1.0d0
  cyl_xc             = 0.5d0
  cyl_yc             = 0.5d0
  cyl_rad            = 0.125d0
  drop_rad           = 0.25d0
  chk_prefix         = 'output/chk_fugu2d'
/
